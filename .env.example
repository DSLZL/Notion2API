# Notion2API environment example
# Copy to .env and adjust values for your deployment.

# Core
N2A_API_KEY=change-me-openai-key
N2A_HOST=127.0.0.1
N2A_PORT=8787

# --------------------------------------------------------------------
# Proxy mode switch
# off | env | http | https | socks5 | resin_forward
# --------------------------------------------------------------------
N2A_PROXY_MODE=off

# Generic proxy endpoints (used by mode http/https/socks5, or as fallback)
N2A_PROXY_URL=
N2A_PROXY_HTTP_URL=
N2A_PROXY_HTTPS_URL=

# Optional standard env proxies (used when proxy_mode=env)
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=

# --------------------------------------------------------------------
# Resin sticky proxy (used when N2A_PROXY_MODE=resin_forward)
# --------------------------------------------------------------------
N2A_RESIN_ENABLED=false
N2A_RESIN_URL=
N2A_RESIN_PLATFORM=Default
# forward | reverse | connect | socks5
N2A_RESIN_MODE=forward
# V1 | LEGACY_V0
N2A_RESIN_AUTH_VERSION=V1
# Optional explicit token override (if empty, token is parsed from N2A_RESIN_URL)
N2A_RESIN_PROXY_TOKEN=

# --------------------------------------------------------------------
# Optional alias env keys (same meaning, lower priority than N2A_* in practice)
# Keep empty unless you explicitly use alias naming.
# --------------------------------------------------------------------
N2A_PROXY_RESIN_ENABLED=
N2A_PROXY_RESIN_URL=
N2A_PROXY_RESIN_PLATFORM=
N2A_PROXY_RESIN_MODE=
N2A_PROXY_RESIN_AUTH_VERSION=
N2A_PROXY_RESIN_PROXY_TOKEN=
